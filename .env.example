# Variables de entorno — Monitor de Vehículo en Tiempo Real
#
# Ninguna es obligatoria: si no se define TRACCAR_SERVER_URL, el proxy usa
# https://demo4.traccar.org por defecto (servidor de demostración público).
#
# En Vercel: Project Settings → Environment Variables (o infra/main.tf).
# En local (vercel dev, o docker compose): copia este archivo a ".env" y
# ajusta el valor. docker-compose.yml lo carga automáticamente si existe.

TRACCAR_SERVER_URL=https://demo4.traccar.org

# Solo usado por server/index.js (el servidor Express dentro de Docker,
# NO aplica en Vercel). Por defecto 8080.
# PORT=8080
